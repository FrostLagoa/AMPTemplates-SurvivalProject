Meta.DisplayName=Survival Project
Meta.Description=Loopback-only Survival Project server supervised by AMP with a scoped Iris SQL Vault projection.
Meta.OS=Windows
Meta.AarchSupport=Native
Meta.Arch=x86_64
Meta.Author=FrostLagoa
Meta.URL=https://github.com/FrostLagoa/AMPTemplates-SurvivalProject
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/FrostLagoa/AMPTemplates-SurvivalProject/main/assets/survivalproject-banner-logo.png
Meta.ConfigManifest=survivalprojectconfig.json
Meta.MetaConfigManifest=survivalprojectmetaconfig.json
Meta.ConfigRoot=survivalproject.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ConfigVersion=1
Meta.ReleaseNotes=First local-only Survival Project runtime. The Java server binds only to 127.0.0.1 and AMP readiness requires every TCP and UDP listener.
Meta.AppConfigId=fcb1214d-b277-4642-9c43-f7b017c70b90
App.DisplayName=Survival Project
App.RootDir=./survivalproject-amp/
App.BaseDirectory=./
App.ExecutableWin=D:\Python\Python310\python.exe
App.WorkingDir=.
App.CommandLineArgs=-u "{{$FullRootDir}}survivalproject-launcher.py" --server-root "{{ServerRoot}}" --credential-store "{{CredentialStorePath}}" --java "{{JavaExecutable}}" --database-host "{{DatabaseHost}}" --database-port {{DatabasePort}} --database-name "{{DatabaseName}}" --bind-address "{{BindAddress}}"
App.UseLinuxIOREDIR=False
App.AppSettings={"ServerRoot":"D:\\SurvivalProject\\Server","JavaExecutable":"C:\\Program Files\\Java\\jdk-25\\bin\\java.exe","CredentialStorePath":"D:\\SurvivalProject\\Server\\config\\iris-sql-vault.local.json","DatabaseHost":"127.0.0.1","DatabasePort":"3306","DatabaseName":"survivalproject","BindAddress":"127.0.0.1"}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=-{0}={1}
App.ExitMethod=String
App.ExitMethodWindows=CtrlC
App.ExitTimeout=30
App.ExitString=ampstop
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.ForceIPBinding=True
App.SupportsIPv6=False
App.ApplicationIPBinding=127.0.0.1
App.Ports=[{"Protocol":0,"Port":21000,"Offset":0,"Range":1,"MinListening":0,"Ref":"ApplicationPort1","Name":"Loopback login service","Description":"Survival Project login service bound only to 127.0.0.1","IsDelayedOpen":false,"Hidden":false,"ChildPorts":null,"Required":false},{"Protocol":0,"Port":21001,"Offset":0,"Range":1,"MinListening":0,"Ref":"ApplicationPort2","Name":"Loopback Beginner channel","Description":"TCP and UDP channel bound only to 127.0.0.1","IsDelayedOpen":false,"Hidden":false,"ChildPorts":null,"Required":false},{"Protocol":0,"Port":21002,"Offset":0,"Range":1,"MinListening":0,"Ref":"ApplicationPort3","Name":"Loopback Hero channel","Description":"TCP and UDP channel bound only to 127.0.0.1","IsDelayedOpen":false,"Hidden":false,"ChildPorts":null,"Required":false},{"Protocol":0,"Port":21003,"Offset":0,"Range":1,"MinListening":0,"Ref":"ApplicationPort4","Name":"Loopback Epic channel","Description":"TCP and UDP channel bound only to 127.0.0.1","IsDelayedOpen":false,"Hidden":false,"ChildPorts":null,"Required":false}]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ApplicationPort1
App.MaxUsers=96
App.UseRandomAdminPassword=False
App.AdminMethod=STDIO
App.UpdateSources=[]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.sql","*.ps1","*.py"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=True
App.MonitorChildProcessName=java.exe
App.MonitorDirectChildOnly=False
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[^\s]*
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^\[survivalproject\] READY login=21000 channels=3$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=0
Limits.SleepStartThresholdSeconds=25
